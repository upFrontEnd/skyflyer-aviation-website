# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et renseigner
# tes propres identifiants Twitch. Procédure complète dans le README, section
# "Intégration Twitch".
VITE_TWITCH_CLIENT_ID=
VITE_TWITCH_ACCESS_TOKEN=

# Formulaire de contact (Web3Forms + reCAPTCHA) — procédure dans le README,
# section "Formulaire de contact".
VITE_WEB3FORMS_ACCESS_KEY=
VITE_RECAPTCHA_SITE_KEY=
